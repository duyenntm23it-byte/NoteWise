APP_ENV=development
APP_NAME=NoteWise API
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql+asyncpg://notewise:notewise@localhost:5432/notewise
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
POSTGRES_DB=notewise
POSTGRES_USER=notewise
POSTGRES_PASSWORD=replace-with-a-strong-database-password