erDiagram
  users {
    uuid id PK
    text email UK
    text password_hash
    timestamptz created_at
  }

  documents {
    uuid id PK
    uuid user_id FK
    text filename
    text storage_key
    text status
    text failure_code
    int page_count
    timestamptz created_at
    timestamptz updated_at
  }

  document_chunks {
    uuid id PK
    uuid user_id FK
    uuid document_id FK
    int chunk_index
    text content
    vector embedding
    int page_number
    text section
  }

  summaries {
    uuid id PK
    uuid user_id FK
    uuid document_id FK
    text content
    text status
    text failure_code
    timestamptz created_at
  }

  quizzes {
    uuid id PK
    uuid user_id FK
    uuid document_id FK
    text title
    text status
    text failure_code
    timestamptz created_at
  }

  quiz_questions {
    uuid id PK
    uuid user_id FK
    uuid quiz_id FK
    int position
    text question
    jsonb options
    jsonb answer_key
    text explanation
    uuid citation_chunk_id FK
  }

  quiz_attempts {
    uuid id PK
    uuid user_id FK
    uuid quiz_id FK
    numeric score
    int correct_count
    int answered_count
    int skipped_count
    timestamptz started_at
    timestamptz submitted_at
  }

  quiz_answers {
    uuid id PK
    uuid user_id FK
    uuid attempt_id FK
    uuid quiz_id FK
    uuid question_id FK
    jsonb submitted_answer
    boolean is_correct
    timestamptz answered_at
  }

  weak_topics {
    uuid id PK
    uuid user_id FK
    text topic
    numeric accuracy
    int attempts
    int answered_count
    boolean sufficient_data
    text evidence
    timestamptz updated_at
  }

  recommendations {
    uuid id PK
    uuid user_id FK
    text topic
    uuid document_id FK
    text action
    text reason
    timestamptz created_at
  }

  learning_history {
    uuid id PK
    uuid user_id FK
    text event_type
    uuid document_id FK
    uuid quiz_attempt_id FK
    text document_title_snapshot
    jsonb details
    timestamptz created_at
  }

  processing_jobs {
    uuid id PK
    uuid user_id FK
    uuid document_id FK
    uuid summary_id FK
    uuid quiz_id FK
    text job_type
    text status
    int attempt_count
    int max_attempts
    timestamptz run_after
    timestamptz lease_expires_at
    text idempotency_key
    text last_error_code
    timestamptz created_at
    timestamptz updated_at
  }

  users ||--o{ documents : owns
  documents ||--o{ document_chunks : contains
  users ||--o{ summaries : owns
  documents ||--o{ summaries : summarized_from
  users ||--o{ quizzes : owns
  documents ||--o{ quizzes : source
  quizzes ||--|{ quiz_questions : contains
  document_chunks o|--o{ quiz_questions : grounds
  users ||--o{ quiz_attempts : performs
  quizzes ||--o{ quiz_attempts : attempted_in
  quiz_attempts ||--o{ quiz_answers : contains
  quiz_questions ||--o{ quiz_answers : answered
  users ||--o{ weak_topics : has
  users ||--o{ recommendations : receives
  documents o|--o{ recommendations : supports
  users ||--o{ learning_history : generates
  documents o|--o{ learning_history : snapshot_reference
  quiz_attempts o|--o{ learning_history : recorded_as
  users ||--o{ processing_jobs : owns
  documents o|--o{ processing_jobs : processes
  summaries o|--o{ processing_jobs : generates
  quizzes o|--o{ processing_jobs : generates
